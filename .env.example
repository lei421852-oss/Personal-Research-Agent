# 复制为 .env 并填写本地配置；不要提交 .env 或任何 API Key。
# LLM 需要支持 function/tool calling，并遵守单轮单动作协议。
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# VLM 需要支持图片输入与严格 JSON 输出；可与 LLM 使用不同提供方。
VLM_API_KEY=
VLM_MODEL=
VLM_BASE_URL=

# day5-controlled 是固定证据的演示检索，不是真实语义排名。
# 使用 real 前须完成 scripts.ingest_corpus --execute，并使用同一模型/索引。
AGENT_RETRIEVAL_BACKEND=day5-controlled
AGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
AGENT_DEVICE=cpu
AGENT_INDEX_DIR=data/chroma/day2
