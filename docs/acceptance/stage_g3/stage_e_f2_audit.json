      "claims": [
        {
          "claim_id": "claim_d0d8319d60dbbe6670df22ad36e51865",
          "requirement_id": "req_9b812a56c386edc56b01ad7612222137",
          "paper_id": "blip-2-2301.12597v1",
          "dimension_id": "vision_language_bridge",
          "text": "BLIP-2 bridges visual representations to the language model via a Querying Transformer (Q-Former) pre-trained in two stages. The Q-Former is connected to a frozen image encoder in the representation learning stage to extract language-informative visual features, and to a frozen LLM in the generative learning stage. The interface is a fully-connected (FC) layer that linearly projects the Q-Former's output query embeddings (Z) into the LLM's text-embedding dimension; these projected query embeddings are prepended to the input text embeddings and serve as soft visual prompts conditioning the LLM on the visual representation. The Q-Former thus acts as an information bottleneck between the frozen image encoder and the frozen LLM.",
          "admission": {
            "review_status": "passed",
            "validation_status": "passed"
          },
          "evidence": [
            {
              "evidence_id": "ev_525a1f73be26c523e5fb57a5a02a3ecc",
