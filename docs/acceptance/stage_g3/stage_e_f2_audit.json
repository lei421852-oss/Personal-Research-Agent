        },
        {
          "claim_id": "claim_62875649e7c28d28a6927947a343c981",
          "requirement_id": "req_638cc283fb01bf590f5233c40f49087a",
          "paper_id": "llava-2304.08485v1",
          "dimension_id": "vision_language_bridge",
          "text": "LLaVA connects visual representations to the language model via a CLIP ViT-L/14 visual encoder that produces visual features Zv = g(Xv), and a trainable linear projection matrix W (a simple linear layer) that maps those image features into the language model's word embedding space, yielding visual tokens Hv/Hq of the same dimensionality as the word embedding space. The projection layer is the trainable interface mediating the connection: in Stage 2 the visual encoder weights stay frozen while the projection layer W and the LLM (φ) are updated.",
          "admission": {
            "review_status": "passed",
